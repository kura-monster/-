# Discord（Developer Portal の Bot / OAuth2 ページで取得）
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 開発中のみ: このサーバーにだけコマンドを即時登録する（空欄なら全サーバー）
DISCORD_GUILD_ID=

# Webダッシュボード
# 公開URL（例: https://democracy.example.com）。OAuth2 の Redirects には「このURL/auth/callback」を登録
WEB_BASE_URL=http://localhost:3000
# 待ち受けるポート。空欄ならホスティングが渡す PORT / SERVER_PORT、どちらもなければ 3000
WEB_PORT=
# 16文字以上のランダムな文字列（本番では必須）
SESSION_SECRET=
# HTTPS を終端するプロキシ（Cloudflare など）を信頼するか。空欄なら WEB_BASE_URL が https:// のとき自動で true
TRUST_PROXY=

# データベース
DATABASE_URL="file:./dev.db"
