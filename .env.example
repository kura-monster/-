# Discord（Developer Portal の Bot / OAuth2 ページで取得）
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 開発中のみ: このサーバーにだけコマンドを即時登録する（空欄なら全サーバー）
DISCORD_GUILD_ID=

# Webダッシュボード
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
# 16文字以上のランダムな文字列（本番では必須）
SESSION_SECRET=
# HTTPS を終端するリバースプロキシの後ろで動かす場合は true
TRUST_PROXY=false

# データベース
DATABASE_URL="file:./dev.db"
